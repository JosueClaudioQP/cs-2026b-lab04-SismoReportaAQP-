@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam classBackgroundColor #EDF5FA
skinparam classBorderColor #234A63
skinparam ArrowColor #234A63
title SismoReporta AQP - clases activas del experimento Lab 07
package "reportes.despues" {
 class ServicioReportes {
  +registrar(reporte)
  +sincronizar(reporte, canal, conectado)
  +procesar(reporte)
  +sugerir_severidad(descripcion)
 }
 class Reporte <<Context>>
 class Estado <<State>>
 class FabricaCanales <<RegistryFactory>>
 abstract class CanalEnvio <<Strategy>>
 class ConReintentos <<Decorator>>
 class Publicador <<Subject>>
 abstract class Suscriptor <<Observer>>
 class ClasificadorSeveridad
 abstract class ProveedorLLM <<Strategy>>
 abstract class Guardrail <<Chain>>
}
class DatosReporte
class Sugerencia
Reporte --|> DatosReporte
Reporte *--> Estado
ServicioReportes --> Reporte
ServicioReportes --> FabricaCanales
FabricaCanales ..> CanalEnvio
ConReintentos --|> CanalEnvio
ConReintentos o--> CanalEnvio
ServicioReportes ..> ConReintentos
ServicioReportes --> Publicador
Publicador o--> Suscriptor
ServicioReportes --> ClasificadorSeveridad
ClasificadorSeveridad --> ProveedorLLM
ClasificadorSeveridad --> Guardrail
ClasificadorSeveridad ..> Sugerencia
note bottom of ServicioReportes
Vista resumida; implementaciones concretas en patrones/*.puml.
El esqueleto Lab 05 permanece en dominio.py y servicios.py.
Su diagrama histórico está en clases-lab05.puml.
end note
@enduml
