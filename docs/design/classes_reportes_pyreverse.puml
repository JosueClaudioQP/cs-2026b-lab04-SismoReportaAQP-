@startuml classes_reportes
set namespaceSeparator none
class "ApiController" as reportes.servicios.ApiController {
  recibir_reporte(r: Reporte) -> int
}
class "Brigada" as reportes.dominio.Brigada {
  disponible : bool
  id : UUID
  nombre : str
}
class "ColaPersistenteAdapter" as reportes.dominio.ColaPersistenteAdapter {
  {abstract}consumir() -> Reporte
  {abstract}publicar(r: Reporte) -> None
}
class "ColaReportes" as reportes.dominio.ColaReportes {
  {abstract}consumir() -> Reporte
  {abstract}publicar(r: Reporte) -> None
}
class "EstadoReporte" as reportes.dominio.EstadoReporte {
  name
}
class "Evidencia" as reportes.dominio.Evidencia {
  tamano_bytes : int
  url_referencia : str
  uuid : UUID
}
class "NivelDanio" as reportes.dominio.NivelDanio {
  name
}
class "Reporte" as reportes.dominio.Reporte {
  brigada : Brigada | None
  descripcion : str
  estado
  evidencias : list[Evidencia]
  latitud : Decimal
  longitud : Decimal
  nivel_danio : NivelDanio | None
  timestamp_dispositivo : datetime
  timestamp_servidor : datetime | None
  uuid : UUID
  asignar_brigada(b: Brigada) -> None
  encolar() -> None
  marcar_atendido() -> None
  marcar_recibido(ts: datetime) -> None
  reintentar() -> None
  verificar(nivel: NivelDanio) -> None
}
class "RepositorioReportes" as reportes.dominio.RepositorioReportes {
  {abstract}buscar(uuid: UUID) -> Reporte
  {abstract}existe(uuid: UUID) -> bool
  {abstract}guardar(r: Reporte) -> None
}
class "ServicioIngesta" as reportes.servicios.ServicioIngesta {
  recibir(r: Reporte) -> bool
  validar_uuid(uuid: UUID) -> bool
}
class "ServicioOperaciones" as reportes.servicios.ServicioOperaciones {
  {abstract}asignar_brigada(reporte_id: UUID, brigada_id: UUID) -> None
  verificar(reporte_id: UUID, nivel: NivelDanio) -> None
}
class "SyncManager" as reportes.servicios.SyncManager {
  intentos : int
  calcular_backoff(intento: int) -> int
  marcar_sincronizado(uuid: UUID) -> None
  registrar(r: Reporte) -> None
  {abstract}sincronizar_pendientes() -> None
}
class "WorkerProcesamiento" as reportes.servicios.WorkerProcesamiento {
  procesar() -> None
}
reportes.dominio.ColaPersistenteAdapter --|> reportes.dominio.ColaReportes
reportes.dominio.Reporte --> reportes.dominio.EstadoReporte : estado
@enduml
