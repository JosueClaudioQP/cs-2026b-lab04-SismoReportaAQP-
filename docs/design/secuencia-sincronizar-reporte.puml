@startuml secuencia-sincronizar-reporte
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
autonumber
actor Ciudadano
participant "App móvil" as UI
participant "SyncManager" as S
participant "ApiController" as A
participant "ServicioIngesta" as I
participant "ColaReportes" as Q
participant "WorkerProcesamiento" as W
participant "Reporte" as P
participant "RepositorioReportes" as R

Ciudadano -> UI : Crea reporte (sin señal)
UI -> S : registrar(reporte)
S --> UI : guardado local (ENCOLADO)
loop por cada reporte pendiente
  S -> S : calcularBackoff(intento)
  alt hay conectividad y el servidor acepta
    S -> A : recibirReporte(reporte)
    A -> I : validarUuid(uuid)
    I --> A : uuid nuevo
    A -> I : recibir(reporte)
    I -> Q : publicar(reporte)
    Q --> I : persistido
    I --> A : aceptado
    A --> S : 202 Accepted
    S -> S : marcarSincronizado(uuid)
    Q ->> W : procesar()
    note right of W : asíncrono\n(no bloquea el 202)
    W -> Q : consumir()
    Q --> W : reporte
    W -> R : existe(uuid)
    R --> W : false
    W -> P : marcarRecibido(ts)
    W -> R : guardar(reporte)
  else sin señal o error de red
    S -> S : calcularBackoff(intento)
    note right of S : reporte sigue ENCOLADO\nreintento con backoff + jitter
  end
end
S --> UI : estado de sincronización
UI --> Ciudadano : Muestra resultado
@enduml
