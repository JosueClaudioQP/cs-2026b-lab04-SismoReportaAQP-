  label=<<br /><font point-size="34">Component View: SismoReporta AQP - Backend modular</font>>

  15 [id=15,shape=rect, label=<<font point-size="34">Proveedor SMS</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Externo: su caída no revierte<br />asignaciones [QA08-03].</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]

