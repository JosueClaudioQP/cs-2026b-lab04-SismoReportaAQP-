  10 -> 13 [id=35, label=<<font point-size="24">Asigna y crea outbox en<br />transacción</font><br /><font point-size="19">[SQL]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  11 -> 13 [id=36, label=<<font point-size="24">Procesa inbox y SMS<br />pendientes</font><br /><font point-size="19">[SQL]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
